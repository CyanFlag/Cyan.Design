<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="using:Avalonia.Media">

    <SolidColorBrush x:Key="ColorPrimaryBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="ColorPrimaryBgBrush" Color="#FFE3F4FF" />
    <SolidColorBrush x:Key="ColorPrimaryBgHoverBrush" Color="#FFD1E9FF" />
    <SolidColorBrush x:Key="ColorPrimaryBorderBrush" Color="#FFB3DEFF" />
    <SolidColorBrush x:Key="ColorPrimaryBorderHoverBrush" Color="#FF84CCFF" />
    <SolidColorBrush x:Key="ColorPrimaryHoverBrush" Color="#FF1C7ED6" />
    <SolidColorBrush x:Key="ColorPrimaryActiveBrush" Color="#FF1971C2" />
    <SolidColorBrush x:Key="ColorPrimaryTextBrush" Color="#FF1971C2" />
    <SolidColorBrush x:Key="ColorPrimaryTextHoverBrush" Color="#FF1C7ED6" />
    <SolidColorBrush x:Key="ColorTextOnPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorTextOnDangerBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="ColorSuccessBrush" Color="#FF0CA678" />
    <SolidColorBrush x:Key="ColorSuccessBgBrush" Color="#FFE6FCF5" />
    <SolidColorBrush x:Key="ColorSuccessBgHoverBrush" Color="#FFC3FAE8" />
    <SolidColorBrush x:Key="ColorSuccessBorderBrush" Color="#FF99F6E0" />
    <SolidColorBrush x:Key="ColorSuccessHoverBrush" Color="#FF099268" />
    <SolidColorBrush x:Key="ColorSuccessActiveBrush" Color="#FF077B5C" />

    <SolidColorBrush x:Key="ColorWarningBrush" Color="#FFFAB005" />
    <SolidColorBrush x:Key="ColorWarningBgBrush" Color="#FFFFF9DB" />
    <SolidColorBrush x:Key="ColorWarningBgHoverBrush" Color="#FFFFF3BF" />
    <SolidColorBrush x:Key="ColorWarningBorderBrush" Color="#FFFFEC99" />
    <SolidColorBrush x:Key="ColorWarningHoverBrush" Color="#FFE8A605" />
    <SolidColorBrush x:Key="ColorWarningActiveBrush" Color="#FFC99400" />

    <SolidColorBrush x:Key="ColorErrorBrush" Color="#FFFA5252" />
    <SolidColorBrush x:Key="ColorErrorBgBrush" Color="#FFFDECEC" />
    <SolidColorBrush x:Key="ColorErrorBgHoverBrush" Color="#FFFAD2D2" />
    <SolidColorBrush x:Key="ColorErrorBorderBrush" Color="#FFFAB8B8" />
    <SolidColorBrush x:Key="ColorErrorHoverBrush" Color="#FFF03E3E" />
    <SolidColorBrush x:Key="ColorErrorActiveBrush" Color="#FFE03131" />

    <SolidColorBrush x:Key="ColorInfoBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="ColorInfoBgBrush" Color="#FFE3F4FF" />
    <SolidColorBrush x:Key="ColorInfoBorderBrush" Color="#FFB3DEFF" />

    <SolidColorBrush x:Key="ColorLinkBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="ColorLinkHoverBrush" Color="#FF1C7ED6" />
    <SolidColorBrush x:Key="ColorLinkActiveBrush" Color="#FF1971C2" />

    <SolidColorBrush x:Key="ColorTextBrush" Color="#FF212529" />
    <SolidColorBrush x:Key="ColorTextSecondaryBrush" Color="#FF495057" />
    <SolidColorBrush x:Key="ColorTextTertiaryBrush" Color="#FF868E96" />
    <SolidColorBrush x:Key="ColorTextQuaternaryBrush" Color="#FFADB5BD" />
    <SolidColorBrush x:Key="ColorTextDisabledBrush" Color="#FFCED4DA" />

    <Color x:Key="ColorBorder">#FFDEE2E6</Color>
    <SolidColorBrush x:Key="ColorBorderBrush" Color="#FFDEE2E6" />
    <SolidColorBrush x:Key="ColorBorderHoverBrush" Color="#FFCED4DA" />
    <SolidColorBrush x:Key="ColorBorderSecondaryBrush" Color="#FFE9ECEF" />
    <SolidColorBrush x:Key="ColorBorderBgBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorSplitBrush" Color="#FFE9ECEF" />

    <SolidColorBrush x:Key="ColorFillBrush" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="ColorFillSecondaryBrush" Color="#FFF8F9FA" />
    <SolidColorBrush x:Key="ColorFillTertiaryBrush" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="ColorFillQuaternaryBrush" Color="#FFF8F9FA" />

    <SolidColorBrush x:Key="ColorBgContainerBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorBgElevatedBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorBgLayoutBrush" Color="#FFF8F9FA" />
    <SolidColorBrush x:Key="ColorBgSpotlightBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorBgBlurBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorBgHoverBrush" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="ColorBgActiveBrush" Color="#FFE9ECEF" />
    <SolidColorBrush x:Key="ColorBgDisabledBrush" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="ColorMaskBgBrush" Color="#80000000" />
    <SolidColorBrush x:Key="ColorHighlightBrush" Color="#FFE3F4FF" />

    <CornerRadius x:Key="BorderRadius">4</CornerRadius>
    <CornerRadius x:Key="BorderRadiusXS">2</CornerRadius>
    <CornerRadius x:Key="BorderRadiusSM">4</CornerRadius>
    <CornerRadius x:Key="BorderRadiusLG">8</CornerRadius>
    <CornerRadius x:Key="BorderRadiusOuter">4</CornerRadius>

    <x:Double x:Key="FontSize">14</x:Double>
    <x:Double x:Key="FontSizeSM">12</x:Double>
    <x:Double x:Key="FontSizeLG">16</x:Double>
    <x:Double x:Key="FontSizeXL">20</x:Double>
    <x:Double x:Key="FontSizeXXL">24</x:Double>
    <x:Double x:Key="FontSizeH1">34</x:Double>
    <x:Double x:Key="FontSizeH2">28</x:Double>
    <x:Double x:Key="FontSizeH3">22</x:Double>
    <x:Double x:Key="FontSizeH4">18</x:Double>
    <x:Double x:Key="FontSizeH5">16</x:Double>
    <x:Double x:Key="FontSizeH6">14</x:Double>

    <x:Double x:Key="FontWeight">400</x:Double>
    <x:Double x:Key="FontWeightStrong">600</x:Double>

    <x:Double x:Key="LineHeight">1.55</x:Double>

    <x:Double x:Key="ControlHeight">36</x:Double>
    <x:Double x:Key="ControlHeightSM">30</x:Double>
    <x:Double x:Key="ControlHeightLG">40</x:Double>
    <x:Double x:Key="ControlHeightXS">24</x:Double>

    <x:Double x:Key="SpacingXXS">4</x:Double>
    <x:Double x:Key="SpacingXS">8</x:Double>
    <x:Double x:Key="SpacingSM">12</x:Double>
    <x:Double x:Key="Spacing">16</x:Double>
    <x:Double x:Key="SpacingMD">20</x:Double>
    <x:Double x:Key="SpacingLG">24</x:Double>
    <x:Double x:Key="SpacingXL">32</x:Double>
    <x:Double x:Key="SpacingXXL">48</x:Double>

    <Thickness x:Key="PaddingSM">8,5</Thickness>
    <Thickness x:Key="Padding">12,7</Thickness>
    <Thickness x:Key="PaddingLG">16,9</Thickness>
    <Thickness x:Key="MarginSM">12,7</Thickness>
    <Thickness x:Key="Margin">16,7</Thickness>

    <media:BoxShadows x:Key="BoxShadow">0 1 3 0 #1A000000, 0 1 2 -1 #0F000000</media:BoxShadows>
    <media:BoxShadows x:Key="BoxShadowSecondary">0 1 3 0 #1A000000, 0 1 2 -1 #0F000000</media:BoxShadows>
    <media:BoxShadows x:Key="BoxShadowTertiary">0 1 2 0 #0F000000</media:BoxShadows>

    <x:Double x:Key="OpacityActive">1</x:Double>
    <x:Double x:Key="OpacityLoading">0.7</x:Double>
    <x:Double x:Key="OpacityDisabled">1</x:Double>

    <SolidColorBrush x:Key="InputActiveBorderColorBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="InputHoverBorderColorBrush" Color="#FFCED4DA" />
    <SolidColorBrush x:Key="InputActiveBgBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputHoverBgBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputAddonBgBrush" Color="#FFF1F3F5" />
    <media:BoxShadows x:Key="InputActiveShadow">0 0 0 3 #1A228BE6</media:BoxShadows>
    <media:BoxShadows x:Key="InputErrorActiveShadow">0 0 0 3 #1AFA5252</media:BoxShadows>
    <media:BoxShadows x:Key="InputWarningActiveShadow">0 0 0 3 #1AFAB005</media:BoxShadows>

    <x:Double x:Key="InputPaddingBlock">7</x:Double>
    <x:Double x:Key="InputPaddingBlockLG">9</x:Double>
    <x:Double x:Key="InputPaddingBlockSM">5</x:Double>
    <x:Double x:Key="InputPaddingInline">12</x:Double>
    <x:Double x:Key="InputPaddingInlineLG">12</x:Double>
    <x:Double x:Key="InputPaddingInlineSM">8</x:Double>
    <x:Double x:Key="InputFontSize">14</x:Double>
    <x:Double x:Key="InputFontSizeLG">16</x:Double>
    <x:Double x:Key="InputFontSizeSM">14</x:Double>

    <SolidColorBrush x:Key="TabItemSelectedBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TabItemsBackgroundBrush" Color="#FFF1F3F5" />

</ResourceDictionary>