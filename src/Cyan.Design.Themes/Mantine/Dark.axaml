<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="using:Avalonia.Media">

    <SolidColorBrush x:Key="ColorPrimaryBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="ColorPrimaryBgBrush" Color="#FF1864AB" />
    <SolidColorBrush x:Key="ColorPrimaryBgHoverBrush" Color="#FF1971C2" />
    <SolidColorBrush x:Key="ColorPrimaryBorderBrush" Color="#FF1971C2" />
    <SolidColorBrush x:Key="ColorPrimaryBorderHoverBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="ColorPrimaryHoverBrush" Color="#FF339AF0" />
    <SolidColorBrush x:Key="ColorPrimaryActiveBrush" Color="#FF54BAFF" />
    <SolidColorBrush x:Key="ColorPrimaryTextBrush" Color="#FF54BAFF" />
    <SolidColorBrush x:Key="ColorPrimaryTextHoverBrush" Color="#FF339AF0" />
    <SolidColorBrush x:Key="ColorTextOnPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorTextOnDangerBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="ColorSuccessBrush" Color="#FF12B886" />
    <SolidColorBrush x:Key="ColorSuccessBgBrush" Color="#FF0B3D2E" />
    <SolidColorBrush x:Key="ColorSuccessBgHoverBrush" Color="#FF0E4A38" />
    <SolidColorBrush x:Key="ColorSuccessBorderBrush" Color="#FF125942" />
    <SolidColorBrush x:Key="ColorSuccessHoverBrush" Color="#FF20C99A" />
    <SolidColorBrush x:Key="ColorSuccessActiveBrush" Color="#FF0CA678" />

    <SolidColorBrush x:Key="ColorWarningBrush" Color="#FFFAB005" />
    <SolidColorBrush x:Key="ColorWarningBgBrush" Color="#FF3D2E05" />
    <SolidColorBrush x:Key="ColorWarningBgHoverBrush" Color="#FF4D3A07" />
    <SolidColorBrush x:Key="ColorWarningBorderBrush" Color="#FF5D4508" />
    <SolidColorBrush x:Key="ColorWarningHoverBrush" Color="#FFFCC419" />
    <SolidColorBrush x:Key="ColorWarningActiveBrush" Color="#FFE8A605" />

    <SolidColorBrush x:Key="ColorErrorBrush" Color="#FFFA5252" />
    <SolidColorBrush x:Key="ColorErrorBgBrush" Color="#FF3B0E0E" />
    <SolidColorBrush x:Key="ColorErrorBgHoverBrush" Color="#FF4B1414" />
    <SolidColorBrush x:Key="ColorErrorBorderBrush" Color="#FF5B1A1A" />
    <SolidColorBrush x:Key="ColorErrorHoverBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="ColorErrorActiveBrush" Color="#FFFA5252" />

    <SolidColorBrush x:Key="ColorInfoBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="ColorInfoBgBrush" Color="#FF1864AB" />
    <SolidColorBrush x:Key="ColorInfoBorderBrush" Color="#FF1971C2" />

    <SolidColorBrush x:Key="ColorLinkBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="ColorLinkHoverBrush" Color="#FF339AF0" />
    <SolidColorBrush x:Key="ColorLinkActiveBrush" Color="#FF54BAFF" />

    <SolidColorBrush x:Key="ColorTextBrush" Color="#FFC9C9C9" />
    <SolidColorBrush x:Key="ColorTextSecondaryBrush" Color="#FF909296" />
    <SolidColorBrush x:Key="ColorTextTertiaryBrush" Color="#FF5C5F66" />
    <SolidColorBrush x:Key="ColorTextQuaternaryBrush" Color="#FF373A40" />
    <SolidColorBrush x:Key="ColorTextDisabledBrush" Color="#FF5C5F66" />

    <Color x:Key="ColorBorder">#FF373A40</Color>
    <SolidColorBrush x:Key="ColorBorderBrush" Color="#FF373A40" />
    <SolidColorBrush x:Key="ColorBorderHoverBrush" Color="#FF5C5F66" />
    <SolidColorBrush x:Key="ColorBorderSecondaryBrush" Color="#FF25262B" />
    <SolidColorBrush x:Key="ColorBorderBgBrush" Color="#FF1A1B1E" />
    <SolidColorBrush x:Key="ColorSplitBrush" Color="#FF25262B" />

    <SolidColorBrush x:Key="ColorFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ColorFillSecondaryBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="ColorFillTertiaryBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ColorFillQuaternaryBrush" Color="#0AFFFFFF" />

    <SolidColorBrush x:Key="ColorBgContainerBrush" Color="#FF25262B" />
    <SolidColorBrush x:Key="ColorBgElevatedBrush" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="ColorBgLayoutBrush" Color="#FF1A1B1E" />
    <SolidColorBrush x:Key="ColorBgSpotlightBrush" Color="#FF373A40" />
    <SolidColorBrush x:Key="ColorBgBlurBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ColorBgHoverBrush" Color="#FF373A40" />
    <SolidColorBrush x:Key="ColorBgActiveBrush" Color="#FF424242" />
    <SolidColorBrush x:Key="ColorBgDisabledBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ColorMaskBgBrush" Color="#80000000" />
    <SolidColorBrush x:Key="ColorHighlightBrush" Color="#FF1864AB" />

    <CornerRadius x:Key="BorderRadius">4</CornerRadius>
    <CornerRadius x:Key="BorderRadiusXS">2</CornerRadius>
    <CornerRadius x:Key="BorderRadiusSM">4</CornerRadius>
    <CornerRadius x:Key="BorderRadiusLG">8</CornerRadius>
    <CornerRadius x:Key="BorderRadiusOuter">4</CornerRadius>

    <x:Double x:Key="FontSize">14</x:Double>
    <x:Double x:Key="FontSizeSM">12</x:Double>
    <x:Double x:Key="FontSizeLG">16</x:Double>
    <x:Double x:Key="FontSizeXL">20</x:Double>
    <x:Double x:Key="FontSizeXXL">24</x:Double>
    <x:Double x:Key="FontSizeH1">34</x:Double>
    <x:Double x:Key="FontSizeH2">28</x:Double>
    <x:Double x:Key="FontSizeH3">22</x:Double>
    <x:Double x:Key="FontSizeH4">18</x:Double>
    <x:Double x:Key="FontSizeH5">16</x:Double>
    <x:Double x:Key="FontSizeH6">14</x:Double>

    <x:Double x:Key="FontWeight">400</x:Double>
    <x:Double x:Key="FontWeightStrong">600</x:Double>

    <x:Double x:Key="LineHeight">1.55</x:Double>

    <x:Double x:Key="ControlHeight">36</x:Double>
    <x:Double x:Key="ControlHeightSM">30</x:Double>
    <x:Double x:Key="ControlHeightLG">40</x:Double>
    <x:Double x:Key="ControlHeightXS">24</x:Double>

    <x:Double x:Key="SpacingXXS">4</x:Double>
    <x:Double x:Key="SpacingXS">8</x:Double>
    <x:Double x:Key="SpacingSM">12</x:Double>
    <x:Double x:Key="Spacing">16</x:Double>
    <x:Double x:Key="SpacingMD">20</x:Double>
    <x:Double x:Key="SpacingLG">24</x:Double>
    <x:Double x:Key="SpacingXL">32</x:Double>
    <x:Double x:Key="SpacingXXL">48</x:Double>

    <Thickness x:Key="PaddingSM">8,5</Thickness>
    <Thickness x:Key="Padding">12,7</Thickness>
    <Thickness x:Key="PaddingLG">16,9</Thickness>
    <Thickness x:Key="MarginSM">12,7</Thickness>
    <Thickness x:Key="Margin">16,7</Thickness>

    <media:BoxShadows x:Key="BoxShadow">0 4 6 -1 #66000000, 0 2 4 -2 #66000000</media:BoxShadows>
    <media:BoxShadows x:Key="BoxShadowSecondary">0 4 6 -1 #66000000, 0 2 4 -2 #66000000</media:BoxShadows>
    <media:BoxShadows x:Key="BoxShadowTertiary">0 1 2 0 #52000000</media:BoxShadows>

    <x:Double x:Key="OpacityActive">1</x:Double>
    <x:Double x:Key="OpacityLoading">0.7</x:Double>
    <x:Double x:Key="OpacityDisabled">1</x:Double>

    <SolidColorBrush x:Key="InputActiveBorderColorBrush" Color="#FF228BE6" />
    <SolidColorBrush x:Key="InputHoverBorderColorBrush" Color="#FF5C5F66" />
    <SolidColorBrush x:Key="InputActiveBgBrush" Color="#FF25262B" />
    <SolidColorBrush x:Key="InputHoverBgBrush" Color="#FF25262B" />
    <SolidColorBrush x:Key="InputAddonBgBrush" Color="#14FFFFFF" />
    <media:BoxShadows x:Key="InputActiveShadow">0 0 0 3 #1A228BE6</media:BoxShadows>
    <media:BoxShadows x:Key="InputErrorActiveShadow">0 0 0 3 #1AFA5252</media:BoxShadows>
    <media:BoxShadows x:Key="InputWarningActiveShadow">0 0 0 3 #1AFAB005</media:BoxShadows>

    <x:Double x:Key="InputPaddingBlock">7</x:Double>
    <x:Double x:Key="InputPaddingBlockLG">9</x:Double>
    <x:Double x:Key="InputPaddingBlockSM">5</x:Double>
    <x:Double x:Key="InputPaddingInline">12</x:Double>
    <x:Double x:Key="InputPaddingInlineLG">12</x:Double>
    <x:Double x:Key="InputPaddingInlineSM">8</x:Double>
    <x:Double x:Key="InputFontSize">14</x:Double>
    <x:Double x:Key="InputFontSizeLG">16</x:Double>
    <x:Double x:Key="InputFontSizeSM">14</x:Double>

    <SolidColorBrush x:Key="TabItemSelectedBrush" Color="#FF1A1B1E" />
    <SolidColorBrush x:Key="TabItemsBackgroundBrush" Color="#FF373A40" />

</ResourceDictionary>