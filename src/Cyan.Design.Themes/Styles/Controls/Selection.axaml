<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Selections">

    <Style Selector="core|CyanCheckbox">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource ColorBgContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border x:Name="PART_Box" Width="16" Height="16" CornerRadius="4"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Background="{TemplateBinding Background}" VerticalAlignment="Center">
                        <Path x:Name="PART_Check" Width="12" Height="12"
                              Data="M1,7 L5,11 L11,2" Stroke="White" StrokeThickness="2"
                              Stretch="Uniform" IsVisible="False"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="core|CyanCheckbox:pointerover /template/ Border#PART_Box">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
    </Style>
    <Style Selector="core|CyanCheckbox:checked /template/ Border#PART_Box">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
    </Style>
    <Style Selector="core|CyanCheckbox:checked /template/ Path#PART_Check">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="core|CyanCheckbox:disabled /template/ Border#PART_Box">
        <Setter Property="Background" Value="{DynamicResource ColorBgDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
    </Style>
    <Style Selector="core|CyanCheckbox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextDisabledBrush}" />
    </Style>


    <Style Selector="core|CyanSwitch">
        <Setter Property="Background" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Track" Width="44" Height="22" CornerRadius="11"
                        Background="{TemplateBinding Background}">
                    <Border x:Name="PART_Knob" Width="18" Height="18" CornerRadius="9"
                            Background="White" Margin="2,0" HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="core|CyanSwitch:checked">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryBrush}" />
    </Style>
    <Style Selector="core|CyanSwitch:checked /template/ Border#PART_Knob">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="core|CyanSwitch:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

</Styles>