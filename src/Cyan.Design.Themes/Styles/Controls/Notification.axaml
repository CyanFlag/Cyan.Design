<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Feedback">

    <Style Selector="core|CyanNotificationItem">
        <Setter Property="Width" Value="320" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Root"
                        Background="{DynamicResource ColorBgElevatedBrush}"
                        CornerRadius="8"
                        Padding="16,12"
                        BoxShadow="0 6 16 #1F000000"
                        BorderBrush="{DynamicResource ColorPrimaryBrush}"
                        BorderThickness="3,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{TemplateBinding Title}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource ColorTextBrush}" />
                        <TextBlock x:Name="PART_Description"
                                   Text="{TemplateBinding Description}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanNotificationItem:type-success /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorSuccessBrush}" />
    </Style>
    <Style Selector="core|CyanNotificationItem:type-warning /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
    </Style>
    <Style Selector="core|CyanNotificationItem:type-error /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
    </Style>

    <Style Selector="core|CyanNotificationItem:has-description /template/ TextBlock#PART_Description">
        <Setter Property="IsVisible" Value="True" />
    </Style>

</Styles>