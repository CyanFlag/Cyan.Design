<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Inputs">

    <Style Selector="core|CyanInput">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource BorderRadius}" />
        <Setter Property="Background" Value="{DynamicResource ColorBgContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ColorPrimaryBgBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ContentPresenter x:Name="PART_AddonBefore"
                                      Grid.Column="0"
                                      Content="{TemplateBinding AddonBefore}"
                                      Padding="11,4"
                                      VerticalAlignment="Stretch"
                                      Background="{DynamicResource ColorFillTertiaryBrush}"
                                      BorderBrush="{DynamicResource ColorBorderBrush}"
                                      BorderThickness="1,1,0,1"
                                      CornerRadius="6,0,0,6"
                                      IsVisible="{TemplateBinding AddonBefore, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border x:Name="PART_Border"
                            Grid.Column="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                              Margin="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_PrefixPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Prefix}"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding Prefix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden">
                                <TextPresenter x:Name="PART_TextPresenter"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Text="{TemplateBinding Text, Mode=TwoWay}" />
                            </ScrollViewer>
                            <TextBlock x:Name="PART_Count"
                                       Grid.Column="2"
                                       Margin="4,0,4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorTextTertiaryBrush}"
                                       FontSize="12"
                                       IsVisible="{TemplateBinding ShowCount}"
                                       Text="{TemplateBinding CountText}" />
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="3"
                                    Width="16" Height="16"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Cursor="Arrow"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    CornerRadius="999"
                                    IsVisible="False">
                                <Path Width="12" Height="12"
                                      Data="M6,6 L12,12 M12,6 L6,12"
                                      Stroke="{DynamicResource ColorTextTertiaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round" />
                            </Button>
                            <ContentPresenter x:Name="PART_SuffixPresenter"
                                              Grid.Column="4"
                                              Content="{TemplateBinding Suffix}"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding Suffix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>
                    </Border>
                    <ContentPresenter x:Name="PART_AddonAfter"
                                      Grid.Column="2"
                                      Content="{TemplateBinding AddonAfter}"
                                      Padding="11,4"
                                      VerticalAlignment="Stretch"
                                      Background="{DynamicResource ColorFillTertiaryBrush}"
                                      BorderBrush="{DynamicResource ColorBorderBrush}"
                                      BorderThickness="0,1,1,1"
                                      CornerRadius="0,6,6,0"
                                      IsVisible="{TemplateBinding AddonAfter, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanInput:not(:disabled):pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBorderHoverBrush}" />
    </Style>
    <Style Selector="core|CyanInput:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputActiveShadow}" />
    </Style>

    <Style Selector="core|CyanInput:disabled">
        <Setter Property="Background" Value="{DynamicResource ColorBgDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextDisabledBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="core|CyanInput:readonly">
        <Setter Property="Background" Value="{DynamicResource ColorFillTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="core|CyanInput:clearvisible /template/ Button#PART_ClearButton">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="core|CyanInput:clearvisible /template/ Button#PART_ClearButton:pointerover /template/ Path">
        <Setter Property="Stroke" Value="{DynamicResource ColorTextSecondaryBrush}" />
    </Style>

    <Style Selector="core|CyanInput[InputStatus=Error]">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
    </Style>
    <Style Selector="core|CyanInput[InputStatus=Error]:not(:disabled):pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorHoverBrush}" />
    </Style>
    <Style Selector="core|CyanInput[InputStatus=Error]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputErrorActiveShadow}" />
    </Style>

    <Style Selector="core|CyanInput[InputStatus=Warning]">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
    </Style>
    <Style Selector="core|CyanInput[InputStatus=Warning]:not(:disabled):pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningHoverBrush}" />
    </Style>
    <Style Selector="core|CyanInput[InputStatus=Warning]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputWarningActiveShadow}" />
    </Style>

    <Style Selector="core|CyanInput[InputVariant=Filled]">
        <Setter Property="Background" Value="{DynamicResource ColorFillTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Filled]:not(:disabled):pointerover">
        <Setter Property="Background" Value="{DynamicResource ColorFillSecondaryBrush}" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Filled]:focus /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ColorBgContainerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputActiveShadow}" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Filled][InputStatus=Error]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputErrorActiveShadow}" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Filled][InputStatus=Warning]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputWarningActiveShadow}" />
    </Style>

    <Style Selector="core|CyanInput[InputVariant=Borderless]">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Borderless]:not(:disabled):pointerover">
        <Setter Property="Background" Value="{DynamicResource ColorFillTertiaryBrush}" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Borderless]:focus /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>

    <Style Selector="core|CyanInput[InputVariant=Underlined]">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Underlined]:focus /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Underlined][InputStatus=Error]:focus /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="core|CyanInput[InputVariant=Underlined][InputStatus=Warning]:focus /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <Style Selector="core|CyanInput[InputSize=Large]">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLG}" />
    </Style>
    <Style Selector="core|CyanInput[InputSize=Small]">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>

    <Style Selector="core|CyanTextArea">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource BorderRadius}" />
        <Setter Property="Background" Value="{DynamicResource ColorBgContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ColorPrimaryBgBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="{TemplateBinding Padding}">
                            <TextPresenter x:Name="PART_TextPresenter"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Top"
                                           Text="{TemplateBinding Text, Mode=TwoWay}" />
                        </ScrollViewer>
                        <TextBlock x:Name="PART_Count"
                                   Grid.Row="1"
                                   Margin="0,4,11,4"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource ColorTextTertiaryBrush}"
                                   FontSize="12"
                                   IsVisible="{TemplateBinding ShowCount}"
                                   Text="{TemplateBinding CountText}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="core|CyanTextArea:not(:disabled):pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBorderHoverBrush}" />
    </Style>
    <Style Selector="core|CyanTextArea:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputActiveShadow}" />
    </Style>
    <Style Selector="core|CyanTextArea:disabled">
        <Setter Property="Background" Value="{DynamicResource ColorBgDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextDisabledBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="core|CyanTextArea:readonly">
        <Setter Property="Background" Value="{DynamicResource ColorFillTertiaryBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="core|CyanTextArea[InputStatus=Error]">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
    </Style>
    <Style Selector="core|CyanTextArea[InputStatus=Error]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputErrorActiveShadow}" />
    </Style>
    <Style Selector="core|CyanTextArea[InputStatus=Warning]">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
    </Style>
    <Style Selector="core|CyanTextArea[InputStatus=Warning]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputWarningActiveShadow}" />
    </Style>
    <Style Selector="core|CyanTextArea[InputVariant=Filled]">
        <Setter Property="Background" Value="{DynamicResource ColorFillTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="core|CyanTextArea[InputVariant=Filled]:focus /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ColorBgContainerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputActiveShadow}" />
    </Style>
    <Style Selector="core|CyanTextArea[InputVariant=Borderless]">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="core|CyanTextArea[InputVariant=Underlined]">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="core|CyanTextArea[InputVariant=Underlined]:focus /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="core|CyanTextArea[InputSize=Small]">
        <Setter Property="MinHeight" Value="60" />
    </Style>
    <Style Selector="core|CyanTextArea[InputSize=Large]">
        <Setter Property="MinHeight" Value="100" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLG}" />
    </Style>

    <Style Selector="core|CyanPassword">
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource BorderRadius}" />
        <Setter Property="Background" Value="{DynamicResource ColorBgContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ColorPrimaryBgBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                          Margin="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_PrefixPresenter"
                                          Grid.Column="0"
                                          Content="{TemplateBinding Prefix}"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding Prefix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden">
                            <TextPresenter x:Name="PART_TextPresenter"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center" />
                        </ScrollViewer>
                        <Button x:Name="PART_ClearButton"
                                Grid.Column="2"
                                Width="16" Height="16"
                                Margin="4,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Cursor="Arrow"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                CornerRadius="999"
                                IsVisible="False">
                            <Path Width="12" Height="12"
                                  Data="M6,6 L12,12 M12,6 L6,12"
                                  Stroke="{DynamicResource ColorTextTertiaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round" />
                        </Button>
                        <Button x:Name="PART_ToggleButton"
                                Grid.Column="3"
                                Width="16" Height="16"
                                Margin="4,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Cursor="Arrow"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                CornerRadius="999">
                            <Path x:Name="PART_EyeIcon"
                                  Width="16" Height="16"
                                  Data="M1,12 C1,12 5,5 12,5 C19,5 23,12 23,12 C23,12 19,19 12,19 C5,19 1,12 1,12 Z M12,9 A3,3 0 1,0 12,15 A3,3 0 1,0 12,9"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource ColorTextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  Stretch="Uniform" />
                        </Button>
                        <ContentPresenter x:Name="PART_SuffixPresenter"
                                          Grid.Column="4"
                                          Content="{TemplateBinding Suffix}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding Suffix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="core|CyanPassword:not(:disabled):pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBorderHoverBrush}" />
    </Style>
    <Style Selector="core|CyanPassword:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputActiveShadow}" />
    </Style>
    <Style Selector="core|CyanPassword:disabled">
        <Setter Property="Background" Value="{DynamicResource ColorBgDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextDisabledBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="core|CyanPassword:pwvisible /template/ Path#PART_EyeIcon">
        <Setter Property="Data" Value="M1,12 C1,12 5,5 12,5 C19,5 23,12 23,12 C23,12 19,19 12,19 C5,19 1,12 1,12 Z M12,9 A3,3 0 1,0 12,15 A3,3 0 1,0 12,9 M3,3 L21,21" />
    </Style>
    <Style Selector="core|CyanPassword[InputStatus=Error]">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
    </Style>
    <Style Selector="core|CyanPassword[InputStatus=Error]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputErrorActiveShadow}" />
    </Style>
    <Style Selector="core|CyanPassword[InputStatus=Warning]">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
    </Style>
    <Style Selector="core|CyanPassword[InputStatus=Warning]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputWarningActiveShadow}" />
    </Style>
    <Style Selector="core|CyanPassword[InputSize=Large]">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLG}" />
    </Style>
    <Style Selector="core|CyanPassword[InputSize=Small]">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="7,0" />
    </Style>

    <Style Selector="core|CyanSearch">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource BorderRadius}" />
        <Setter Property="Background" Value="{DynamicResource ColorBgContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ColorPrimaryBgBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SearchButtonBackground" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="SearchButtonForeground" Value="White" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                    <Border x:Name="PART_Border"
                            Grid.Column="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                              Margin="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_PrefixPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Prefix}"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding Prefix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden">
                                <TextPresenter x:Name="PART_TextPresenter"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Text="{TemplateBinding Text, Mode=TwoWay}" />
                            </ScrollViewer>
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="2"
                                    Width="16" Height="16"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Cursor="Arrow"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    CornerRadius="999"
                                    IsVisible="False">
                                <Path Width="12" Height="12"
                                      Data="M6,6 L12,12 M12,6 L6,12"
                                      Stroke="{DynamicResource ColorTextTertiaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round" />
                            </Button>
                            <Button x:Name="PART_SearchSuffixButton"
                                    Grid.Column="3"
                                    Width="16" Height="16"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    CornerRadius="0">
                                <Path Width="16" Height="16"
                                      Stretch="Uniform"
                                      Data="M11,4 A7,7 0 1,0 11,18 A7,7 0 1,0 11,4 M16.5,16.5 L21,21"
                                      Stroke="{DynamicResource ColorTextSecondaryBrush}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round" />
                            </Button>
                            <ContentPresenter x:Name="PART_SuffixPresenter"
                                              Grid.Column="4"
                                              Content="{TemplateBinding Suffix}"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding Suffix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>
                    </Border>
                    <Button x:Name="PART_SearchButton"
                            Grid.Column="1"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding SearchButtonBackground}"
                            BorderBrush="{TemplateBinding SearchButtonBackground}"
                            Foreground="{TemplateBinding SearchButtonForeground}"
                            CornerRadius="0,6,6,0"
                            BorderThickness="1,1,1,1"
                            Padding="15,4"
                            Cursor="Hand"
                            IsVisible="False"
                            VerticalAlignment="Stretch">
                        <Panel>
                            <Path x:Name="PART_SearchIcon"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Data="M11,4 A7,7 0 1,0 11,18 A7,7 0 1,0 11,4 M16.5,16.5 L21,21"
                                  Stroke="{TemplateBinding SearchButtonForeground}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  IsVisible="False" />
                            <ContentPresenter x:Name="PART_EnterButtonContent"
                                              Content="{TemplateBinding EnterButton}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              IsVisible="False" />
                        </Panel>
                    </Button>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanSearch:not(:disabled):pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBorderHoverBrush}" />
    </Style>
    <Style Selector="core|CyanSearch:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputActiveShadow}" />
    </Style>

    <Style Selector="core|CyanSearch:enterbutton /template/ Button#PART_SearchSuffixButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="core|CyanSearch:enterbutton /template/ Button#PART_SearchButton">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="core|CyanSearch:enterbutton /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="6,0,0,6" />
        <Setter Property="BorderThickness" Value="1,1,0,1" />
    </Style>

    <Style Selector="core|CyanSearch:enterbutton-icon /template/ Path#PART_SearchIcon">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="core|CyanSearch:enterbutton-text /template/ ContentPresenter#PART_EnterButtonContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="core|CyanSearch:enterbutton-content /template/ ContentPresenter#PART_EnterButtonContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="core|CyanSearch:loading /template/ Button#PART_SearchButton">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Cursor" Value="Wait" />
    </Style>
    <Style Selector="core|CyanSearch:loading /template/ Button#PART_SearchSuffixButton">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Cursor" Value="Wait" />
    </Style>

    <Style Selector="core|CyanSearch[InputSize=Large]">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLG}" />
    </Style>
    <Style Selector="core|CyanSearch[InputSize=Small]">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="7,0" />
    </Style>
    <Style Selector="core|CyanSearch[InputStatus=Error]">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
    </Style>
    <Style Selector="core|CyanSearch[InputStatus=Error]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputErrorActiveShadow}" />
    </Style>
    <Style Selector="core|CyanSearch[InputStatus=Warning]">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
    </Style>
    <Style Selector="core|CyanSearch[InputStatus=Warning]:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource InputWarningActiveShadow}" />
    </Style>

</Styles>
