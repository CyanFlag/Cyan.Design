<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Feedback"
        xmlns:btn="using:Cyan.Design.Core.Controls.Buttons">

    <Style Selector="core|CyanModal">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ZIndex" Value="1000" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Mask" Background="{DynamicResource ColorMaskBgBrush}" />

                    <Border x:Name="PART_Content"
                            Background="{DynamicResource ColorBgElevatedBrush}"
                            CornerRadius="8"
                            Width="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,100,0,0"
                            BoxShadow="{DynamicResource BoxShadow}">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Border Grid.Row="0"
                                    Padding="20,16"
                                    BorderBrush="{DynamicResource ColorSplitBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding Title}"
                                                      FontSize="16" FontWeight="600"
                                                      Foreground="{DynamicResource ColorTextBrush}"
                                                      VerticalAlignment="Center" />
                                    <Border Grid.Column="1" x:Name="PART_Close"
                                            Cursor="Hand" Padding="4"
                                            VerticalAlignment="Center"
                                            Margin="0,0,-4,0">
                                        <TextBlock Text="×" FontSize="18"
                                                   Foreground="{DynamicResource ColorTextTertiaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" Padding="20">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </ScrollViewer>

                            <Border Grid.Row="2"
                                    Padding="8,12"
                                    BorderBrush="{DynamicResource ColorSplitBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right"
                                                IsVisible="False"
                                                x:Name="PART_DefaultFooter">
                                        <btn:CyanButton x:Name="PART_CancelButton"
                                                       Content="{TemplateBinding CancelText}"
                                                       ClickMode="Press" />
                                        <btn:CyanButton x:Name="PART_OkButton"
                                                       Content="{TemplateBinding OkText}"
                                                       ButtonType="{TemplateBinding OkType}"
                                                       Loading="{TemplateBinding ConfirmLoading}" />
                                    </StackPanel>
                                    <ContentPresenter x:Name="PART_CustomFooter"
                                                      Content="{TemplateBinding Footer}"
                                                      IsVisible="False" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanModal:open">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="core|CyanModal:centered /template/ Border#PART_Content">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="core|CyanModal:no-mask /template/ Border#PART_Mask">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="core|CyanModal:no-closable /template/ Border#PART_Close">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="core|CyanModal:not(:has-footer) /template/ StackPanel#PART_DefaultFooter">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="core|CyanModal:has-footer /template/ ContentPresenter#PART_CustomFooter">
        <Setter Property="IsVisible" Value="True" />
    </Style>

</Styles>