<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Navigation">

    <Style Selector="core|CyanParkTabs">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding ListContent}" />
                        <Border x:Name="PART_Indicator"
                                Background="{DynamicResource ColorPrimaryBrush}"
                                IsVisible="False"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left" />
                    </Grid>
                    <ContentPresenter Content="{TemplateBinding PanelContent}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanParkTabs:vertical">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding ListContent}" />
                        <Border x:Name="PART_Indicator"
                                Background="{DynamicResource ColorPrimaryBrush}"
                                IsVisible="False"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left" />
                    </Grid>
                    <ContentPresenter Content="{TemplateBinding PanelContent}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanParkTabList">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style Selector="core|CyanParkTabs:vertical core|CyanParkTabList">
        <Setter Property="Orientation" Value="Vertical" />
    </Style>

    <Style Selector="core|CyanParkTabTrigger">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTertiaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{DynamicResource BorderRadiusSM}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanParkTabTrigger:selected">
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}" />
    </Style>

    <Style Selector="core|CyanParkTabTrigger:pointerover:not(:selected)">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
    </Style>

    <Style Selector="core|CyanParkTabTrigger:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="core|CyanParkTabs:fitted core|CyanParkTabList">
        <Setter Property="Spacing" Value="0" />
    </Style>

    <Style Selector="core|CyanParkTabs:fitted core|CyanParkTabTrigger">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="core|CyanParkTabs:subtle core|CyanParkTabTrigger:selected">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}" />
    </Style>

    <Style Selector="core|CyanParkTabs:enclosed">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Vertical" Spacing="4">
                    <Border Background="{DynamicResource ColorFillQuaternaryBrush}"
                            CornerRadius="{DynamicResource BorderRadiusLG}"
                            Padding="4">
                        <Grid>
                            <Border x:Name="PART_Indicator"
                                    Background="{DynamicResource ColorBgContainerBrush}"
                                    CornerRadius="{DynamicResource BorderRadiusSM}"
                                    BoxShadow="{DynamicResource BoxShadowTertiary}"
                                    IsVisible="False"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Left" />
                            <ContentPresenter Content="{TemplateBinding ListContent}" />
                        </Grid>
                    </Border>
                    <ContentPresenter Content="{TemplateBinding PanelContent}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanParkTabs:enclosed core|CyanParkTabTrigger:selected">

        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
    </Style>

    <Style Selector="core|CyanParkTabContent">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
    </Style>

</Styles>