<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Overlays"
        xmlns:conv="using:Avalonia.Data.Converters">

    <Style Selector="core|CyanShadCommand">
        <Setter Property="Background" Value="{DynamicResource ColorBgElevatedBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="TextBox.ShadCommandInput">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Watermark" Value="Type a command or search..." />
        <Setter Property="CaretBrush" Value="{DynamicResource ColorTextTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="ScrollViewer.ShadCommandList">
        <Setter Property="MaxHeight" Value="320" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="core|CyanShadCommandGroup">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{TemplateBinding Heading}"
                               FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource ColorTextTertiaryBrush}"
                               Padding="8,6,8,2"
                               IsVisible="{TemplateBinding Heading, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanShadCommandItem">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ColorTextBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ContentPresenter Grid.Column="0" Content="{TemplateBinding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{TemplateBinding Shortcut}" Foreground="{DynamicResource ColorTextTertiaryBrush}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanShadCommandItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource ColorFillTertiaryBrush}" />
    </Style>

    <Style Selector="core|CyanShadCommandItem:selected">
        <Setter Property="Background" Value="{DynamicResource ColorFillTertiaryBrush}" />
    </Style>

    <Style Selector="core|CyanShadCommandDialog">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Popup x:Name="PART_Popup" Placement="Center" IsLightDismissEnabled="True">
                        <Grid x:Name="PART_OverlayGrid" Background="Transparent">
                            <Border x:Name="PART_OverlayBorder" Background="{DynamicResource ColorMaskBgBrush}" IsVisible="{TemplateBinding ShowOverlay}" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,80" />
                        </Grid>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
