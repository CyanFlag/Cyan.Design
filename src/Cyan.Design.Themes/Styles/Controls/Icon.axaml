<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Icons">

    <Style Selector="core|CyanIcon">
        <Setter Property="FontFamily" Value="avares://Cyan.Design.Themes/Assets/iconfont.ttf#iconfont" />

        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>