<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Selections">

    <!-- CyanSwitch 基础样式 -->
    <Style Selector="core|CyanSwitch">
        <Setter Property="Background" Value="{DynamicResource ColorTextTertiaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="100"
                        Height="22"
                        MinWidth="44"
                        Padding="{TemplateBinding Padding}">
                    <Grid>
                        <ContentPresenter x:Name="PART_CheckedContent"
                                          Content="{TemplateBinding CheckedChildren}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="9,0,27,0"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Opacity="0" />

                        <ContentPresenter x:Name="PART_UncheckedContent"
                                          Content="{TemplateBinding UncheckedChildren}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="27,0,9,0"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Opacity="1" />

                        <Border x:Name="PART_Handle"
                                Width="18" Height="18"
                                CornerRadius="100"
                                Background="{DynamicResource ColorBgContainerBrush}"
                                BoxShadow="0 2 4 0 #3300230B"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- 选中状态 -->
    <Style Selector="core|CyanSwitch:checked">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryBrush}" />
    </Style>
    <Style Selector="core|CyanSwitch:checked /template/ ContentPresenter#PART_CheckedContent">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="core|CyanSwitch:checked /template/ ContentPresenter#PART_UncheckedContent">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="core|CyanSwitch:checked /template/ Border#PART_Handle">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- 选中悬停 -->
    <Style Selector="core|CyanSwitch:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHoverBrush}" />
    </Style>

    <!-- 未选中悬停 -->
    <Style Selector="core|CyanSwitch:not(:checked):pointerover">
        <Setter Property="Background" Value="{DynamicResource ColorTextSecondaryBrush}" />
    </Style>

    <!-- 小尺寸 -->
    <Style Selector="core|CyanSwitch:small">
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="core|CyanSwitch:small /template/ Border#PART_Root">
        <Setter Property="Height" Value="16" />
        <Setter Property="MinWidth" Value="28" />
    </Style>
    <Style Selector="core|CyanSwitch:small /template/ Border#PART_Handle">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="core|CyanSwitch:small /template/ ContentPresenter#PART_CheckedContent">
        <Setter Property="Margin" Value="6,0,18,0" />
    </Style>
    <Style Selector="core|CyanSwitch:small /template/ ContentPresenter#PART_UncheckedContent">
        <Setter Property="Margin" Value="18,0,6,0" />
    </Style>

    <!-- 大尺寸 -->
    <Style Selector="core|CyanSwitch:large">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="core|CyanSwitch:large /template/ Border#PART_Root">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="56" />
    </Style>
    <Style Selector="core|CyanSwitch:large /template/ Border#PART_Handle">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="core|CyanSwitch:large /template/ ContentPresenter#PART_CheckedContent">
        <Setter Property="Margin" Value="12,0,36,0" />
    </Style>
    <Style Selector="core|CyanSwitch:large /template/ ContentPresenter#PART_UncheckedContent">
        <Setter Property="Margin" Value="36,0,12,0" />
    </Style>

    <!-- 禁用状态 -->
    <Style Selector="core|CyanSwitch:disabled">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 加载状态 -->
    <Style Selector="core|CyanSwitch:loading">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

</Styles>