<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Cyan.Design.Core.Controls.Feedback">

    <Style Selector="core|CyanMessageItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource ColorBgElevatedBrush}"
                        CornerRadius="6"
                        Padding="12,10"
                        BoxShadow="0 6 16 #1F000000">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="PART_Icon"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Text}"
                                   FontSize="14"
                                   Foreground="{DynamicResource ColorTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="core|CyanMessageItem:type-success /template/ TextBlock#PART_Icon">
        <Setter Property="Text" Value="✓" />
        <Setter Property="Foreground" Value="{DynamicResource ColorSuccessBrush}" />
    </Style>
    <Style Selector="core|CyanMessageItem:type-info /template/ TextBlock#PART_Icon">
        <Setter Property="Text" Value="i" />
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}" />
    </Style>
    <Style Selector="core|CyanMessageItem:type-warning /template/ TextBlock#PART_Icon">
        <Setter Property="Text" Value="!" />
        <Setter Property="Foreground" Value="{DynamicResource ColorWarningBrush}" />
    </Style>
    <Style Selector="core|CyanMessageItem:type-error /template/ TextBlock#PART_Icon">
        <Setter Property="Text" Value="✕" />
        <Setter Property="Foreground" Value="{DynamicResource ColorErrorBrush}" />
    </Style>
    <Style Selector="core|CyanMessageItem:type-loading /template/ TextBlock#PART_Icon">
        <Setter Property="Text" Value="⟳" />
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}" />
    </Style>

</Styles>