<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             x:Class="Cyan.Design.Demo.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Cyan.Design.Themes/CyanDesignTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <fluent:FluentTheme />
        <StyleInclude Source="avares://Cyan.Design.Themes/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
