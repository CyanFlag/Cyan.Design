<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Cyan.Design.Core.Controls.Selections"
             xmlns:icon="using:Cyan.Design.Core.Controls.Icons"
             xmlns:controls="using:Cyan.Design.Demo.Controls"
             x:Class="Cyan.Design.Demo.Pages.SegmentedPage">
    <ScrollViewer Padding="0" Margin="25">
        <StackPanel Spacing="20" MaxWidth="800">
            <TextBlock Text="Segmented 分段控制器" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ColorTextBrush}"/>
            <TextBlock Text="参考 ant.design 5.x：展示多个选项并允许用户选择单个选项。" Foreground="{DynamicResource ColorTextSecondaryBrush}" TextWrapping="Wrap"/>

            <controls:DemoSection Title="基本">
                <core:CyanSegmented>
                    <core:CyanSegmentedItem Label="Daily" Value="1" />
                    <core:CyanSegmentedItem Label="Weekly" Value="2" />
                    <core:CyanSegmentedItem Label="Monthly" Value="3" />
                    <core:CyanSegmentedItem Label="Quarterly" Value="4" />
                    <core:CyanSegmentedItem Label="Yearly" Value="5" />
                </core:CyanSegmented>
            </controls:DemoSection>

            <controls:DemoSection Title="三种尺寸">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Small" Width="60" VerticalAlignment="Center" Foreground="{DynamicResource ColorTextSecondaryBrush}"/>
                        <core:CyanSegmented Size="Small">
                            <core:CyanSegmentedItem Label="Daily" Value="1" />
                            <core:CyanSegmentedItem Label="Weekly" Value="2" />
                            <core:CyanSegmentedItem Label="Monthly" Value="3" />
                        </core:CyanSegmented>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Medium" Width="60" VerticalAlignment="Center" Foreground="{DynamicResource ColorTextSecondaryBrush}"/>
                        <core:CyanSegmented Size="Middle">
                            <core:CyanSegmentedItem Label="Daily" Value="1" />
                            <core:CyanSegmentedItem Label="Weekly" Value="2" />
                            <core:CyanSegmentedItem Label="Monthly" Value="3" />
                        </core:CyanSegmented>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Large" Width="60" VerticalAlignment="Center" Foreground="{DynamicResource ColorTextSecondaryBrush}"/>
                        <core:CyanSegmented Size="Large">
                            <core:CyanSegmentedItem Label="Daily" Value="1" />
                            <core:CyanSegmentedItem Label="Weekly" Value="2" />
                            <core:CyanSegmentedItem Label="Monthly" Value="3" />
                        </core:CyanSegmented>
                    </StackPanel>
                </StackPanel>
            </controls:DemoSection>

            <controls:DemoSection Title="Block 撑满父元素">
                <core:CyanSegmented Block="True">
                    <core:CyanSegmentedItem Label="Map" Value="1" />
                    <core:CyanSegmentedItem Label="Transit" Value="2" />
                    <core:CyanSegmentedItem Label="Satellite" Value="3" />
                </core:CyanSegmented>
            </controls:DemoSection>

            <controls:DemoSection Title="横向方向">
                <core:CyanSegmented Orientation="Horizontal">
                    <core:CyanSegmentedItem Label="Daily" Value="1" />
                    <core:CyanSegmentedItem Label="Weekly" Value="2" />
                    <core:CyanSegmentedItem Label="Monthly" Value="3" />
                </core:CyanSegmented>
            </controls:DemoSection>

            <controls:DemoSection Title="Round 圆角">
                <core:CyanSegmented Shape="Round">
                    <core:CyanSegmentedItem Label="Daily" Value="1" />
                    <core:CyanSegmentedItem Label="Weekly" Value="2" />
                    <core:CyanSegmentedItem Label="Monthly" Value="3" />
                </core:CyanSegmented>
            </controls:DemoSection>

            <controls:DemoSection Title="胶囊形态（Round + Icon）">
                <core:CyanSegmented Shape="Round" Size="Small">
                    <core:CyanSegmentedItem Value="day">
                        <core:CyanSegmentedItem.Icon>
                            <icon:CyanIcon IconKey="sun-line" FontSize="16" />
                        </core:CyanSegmentedItem.Icon>
                    </core:CyanSegmentedItem>
                    <core:CyanSegmentedItem Value="night">
                        <core:CyanSegmentedItem.Icon>
                            <icon:CyanIcon IconKey="moon-line" FontSize="16" />
                        </core:CyanSegmentedItem.Icon>
                    </core:CyanSegmentedItem>
                </core:CyanSegmented>
            </controls:DemoSection>

            <controls:DemoSection Title="禁用">
                <StackPanel Spacing="12">
                    <core:CyanSegmented Disabled="True">
                        <core:CyanSegmentedItem Label="Daily" Value="1" />
                        <core:CyanSegmentedItem Label="Weekly" Value="2" />
                        <core:CyanSegmentedItem Label="Monthly" Value="3" />
                    </core:CyanSegmented>
                    <core:CyanSegmented>
                        <core:CyanSegmentedItem Label="Daily" Value="1" />
                        <core:CyanSegmentedItem Label="Weekly" Value="2" Disabled="True" />
                        <core:CyanSegmentedItem Label="Monthly" Value="3" />
                    </core:CyanSegmented>
                </StackPanel>
            </controls:DemoSection>

            <controls:DemoSection Title="带图标">
                <core:CyanSegmented>
                    <core:CyanSegmentedItem Label="List" Value="1">
                        <core:CyanSegmentedItem.Icon>
                            <icon:CyanIcon IconKey="list" FontSize="14" />
                        </core:CyanSegmentedItem.Icon>
                    </core:CyanSegmentedItem>
                    <core:CyanSegmentedItem Label="Kanban" Value="2">
                        <core:CyanSegmentedItem.Icon>
                            <icon:CyanIcon IconKey="folder" FontSize="14" />
                        </core:CyanSegmentedItem.Icon>
                    </core:CyanSegmentedItem>
                    <core:CyanSegmentedItem Label="Calendar" Value="3">
                        <core:CyanSegmentedItem.Icon>
                            <icon:CyanIcon IconKey="check" FontSize="14" />
                        </core:CyanSegmentedItem.Icon>
                    </core:CyanSegmentedItem>
                </core:CyanSegmented>
            </controls:DemoSection>

            <controls:DemoSection Title="仅图标">
                <core:CyanSegmented>
                    <core:CyanSegmentedItem Value="1">
                        <core:CyanSegmentedItem.Icon>
                            <icon:CyanIcon IconKey="list" FontSize="16" />
                        </core:CyanSegmentedItem.Icon>
                    </core:CyanSegmentedItem>
                    <core:CyanSegmentedItem Value="2">
                        <core:CyanSegmentedItem.Icon>
                            <icon:CyanIcon IconKey="folder" FontSize="16" />
                        </core:CyanSegmentedItem.Icon>
                    </core:CyanSegmentedItem>
                    <core:CyanSegmentedItem Value="3">
                        <core:CyanSegmentedItem.Icon>
                            <icon:CyanIcon IconKey="check" FontSize="16" />
                        </core:CyanSegmentedItem.Icon>
                    </core:CyanSegmentedItem>
                </core:CyanSegmented>
            </controls:DemoSection>

            <controls:DemoSection Title="受控模式（默认选中 Weekly）">
                <StackPanel Spacing="8">
                    <core:CyanSegmented x:Name="ControlledSegmented" SelectedValue="2">
                        <core:CyanSegmentedItem Label="Daily" Value="1" />
                        <core:CyanSegmentedItem Label="Weekly" Value="2" />
                        <core:CyanSegmentedItem Label="Monthly" Value="3" />
                    </core:CyanSegmented>
                    <TextBlock x:Name="SelectedValueText" Text="当前选中: 2" Foreground="{DynamicResource ColorTextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </controls:DemoSection>

        </StackPanel>
    </ScrollViewer>
</UserControl>
