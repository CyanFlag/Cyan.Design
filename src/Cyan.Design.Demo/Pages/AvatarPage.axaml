<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Cyan.Design.Core.Controls.Display"
             xmlns:controls="using:Cyan.Design.Demo.Controls"
             x:Class="Cyan.Design.Demo.Pages.AvatarPage">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800">
            <TextBlock Text="Avatar 头像" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ColorTextBrush}"/>
            <TextBlock Text="参考 ant.design 5.x：图片/图标/字符三种类型，circle/square 两种形状，large/medium/small 三种尺寸。支持徽标和头像组合。" Foreground="{DynamicResource ColorTextSecondaryBrush}" TextWrapping="Wrap"/>

            <controls:DemoSection Title="基本：尺寸 + 形状">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                    <core:CyanAvatar Size="Large" Source="avares://Cyan.Design.Demo/Assets/user.png" />
                    <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                    <core:CyanAvatar Size="Small" Source="avares://Cyan.Design.Demo/Assets/user.png" />
                    <core:CyanAvatar Size="Large" Shape="Square" Source="avares://Cyan.Design.Demo/Assets/user.png" />
                    <core:CyanAvatar Shape="Square" Source="avares://Cyan.Design.Demo/Assets/user.png" />
                    <core:CyanAvatar Size="Small" Shape="Square" Source="avares://Cyan.Design.Demo/Assets/user.png" />
                </StackPanel>
            </controls:DemoSection>

            <controls:DemoSection Title="字符类型：自定义背景色">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                    <core:CyanAvatar Text="U" Size="Large" />
                    <core:CyanAvatar Text="U" />
                    <core:CyanAvatar Text="U" Size="Small" />
                    <core:CyanAvatar Text="USER" />
                    <core:CyanAvatar Text="U" Background="{DynamicResource ColorPrimaryBrush}" />
                    <core:CyanAvatar Text="U" Background="{DynamicResource ColorErrorBrush}" />
                    <core:CyanAvatar Text="U" Background="{DynamicResource ColorWarningBrush}" />
                    <core:CyanAvatar Text="U" Background="{DynamicResource ColorSuccessBrush}" />
                </StackPanel>
            </controls:DemoSection>

            <controls:DemoSection Title="图标类型：自定义图标颜色及背景色" Description="通过 Foreground 控制图标颜色，Background 控制背景色">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                    <core:CyanAvatar Size="Large">
                        <core:CyanAvatar.Icon>
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </core:CyanAvatar.Icon>
                    </core:CyanAvatar>
                    <core:CyanAvatar>
                        <core:CyanAvatar.Icon>
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </core:CyanAvatar.Icon>
                    </core:CyanAvatar>
                    <core:CyanAvatar Size="Small">
                        <core:CyanAvatar.Icon>
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </core:CyanAvatar.Icon>
                    </core:CyanAvatar>
                    <core:CyanAvatar Foreground="#FF1890FF" Background="#FFE6F7FF">
                        <core:CyanAvatar.Icon>
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </core:CyanAvatar.Icon>
                    </core:CyanAvatar>
                    <core:CyanAvatar Foreground="#FFFFFFFF" Background="{DynamicResource ColorPrimaryBrush}">
                        <core:CyanAvatar.Icon>
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </core:CyanAvatar.Icon>
                    </core:CyanAvatar>
                    <core:CyanAvatar Foreground="#FFFFFFFF" Background="{DynamicResource ColorSuccessBrush}" Shape="Square">
                        <core:CyanAvatar.Icon>
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </core:CyanAvatar.Icon>
                    </core:CyanAvatar>
                </StackPanel>
            </controls:DemoSection>

            <controls:DemoSection Title="带徽标的头像" Description="支持圆点徽标(BadgeDot)和文字徽标(BadgeText)，可通过 BadgeColor 自定义徽标颜色">
                <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" BadgeDot="True" />
                        <core:CyanAvatar Text="U" BadgeDot="True" />
                        <core:CyanAvatar Text="U" BadgeDot="True" BadgeColor="{DynamicResource ColorSuccessBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" BadgeText="1" />
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" BadgeText="99+" />
                        <core:CyanAvatar Text="U" BadgeText="5" BadgeColor="{DynamicResource ColorPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </controls:DemoSection>

            <controls:DemoSection Title="头像组合" Description="CyanAvatarGroup 自动重叠排列，支持 MaxCount 限制最大显示数量">
                <StackPanel Spacing="16" Margin="0,8,0,0">
                    <core:CyanAvatarGroup>
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                        <core:CyanAvatar Text="K" Background="{DynamicResource ColorPrimaryBrush}" />
                        <core:CyanAvatar Text="A" Background="{DynamicResource ColorErrorBrush}" />
                        <core:CyanAvatar Text="Z" Background="{DynamicResource ColorWarningBrush}" />
                    </core:CyanAvatarGroup>
                    <core:CyanAvatarGroup>
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                        <core:CyanAvatar Text="M" Background="{DynamicResource ColorSuccessBrush}" />
                        <core:CyanAvatar Text="N" Background="{DynamicResource ColorPrimaryBrush}" />
                    </core:CyanAvatarGroup>
                    <TextBlock Text="MaxCount=3：" Foreground="{DynamicResource ColorTextSecondaryBrush}" FontSize="12"/>
                    <core:CyanAvatarGroup MaxCount="3">
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                        <core:CyanAvatar Source="avares://Cyan.Design.Demo/Assets/user.png" />
                    </core:CyanAvatarGroup>
                </StackPanel>
            </controls:DemoSection>

        </StackPanel>
    </ScrollViewer>
</UserControl>
